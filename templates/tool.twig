{% autoescape false %}
    {% macro build_option(page, deep) %}
        <option value="{{ page.page_id }}">{% if(deep > 0) %}{% for i in 1..deep %}- {% endfor %}{% endif %}{{ page.page_title }}</option>
        {% if( page.subpages|length > 0) %}
            {% import _self as make_option %}
            {% for subpage in page.subpages %}
                {{ make_option.build_option(subpage, deep+1) }}
            {% endfor %}
        {% endif %}
    {% endmacro %}
{% if ((Message) && (Message != "")) %}
<p alt="construction sign" class="message_img">
    <img class="construction_site" src="{{ WB_URL }}/modules/Subway/img/construction_site.png"/>
</p>
<p class="spacer1"></p>
    <div class="headMessageBox">
        <div class="ui message olive center large">
            {% for icon in icons %}
                <i class="ui icon {{ icon }}"></i><span class="icon_hspacer"></span>
            {% endfor %}
            {{  Message }}
        </div>
    </div>
{% endif %}
<p class="spacer1"></p>
<div class="ip_form_box">
<form class="ui form">
<table class="ui celled table">
    <thead>
        <tr>
            <th class="one wide column">{{ lang.TH_LABELS.id }}</th>
            <th class="three wide column">{{ lang.TH_LABELS.user }}</th>
            <th class="six wide column">{{ lang.TH_LABELS.page }}</th>
            <th class="two wide column">{{ lang.TH_LABELS.params }}</th
        </tr></thead>
    <tbody>
        <tr>
            <td data-label="Name">1</td>
            <td data-label="Age">Alsussd</td>
            <td data-label="Job">
                <select class="ui select">
                    <optgroup label="Pages">                  
                        {% import _self as make_option %}
                        {% for page in pages %}
                            {{ make_option.build_option( page, 0) }}
                        {% endfor %}
                    </ortgroup>
                    <optgroup label="Admintools">
                    {% for tool in admintools %}
                    <option value="{{ tool.directory }}">{{ tool.name }}</option>
                    {% endfor %}
                    </optgroup>
                    <optgroup label="Backend">
                        {% for key, value in backendPages %}
                            <option value="{{ value }}">{{ key }}</option>
                        {% endfor %}
                    </optgroup>
                </select>
            </td>
            <td>
                <input type="text" />
            </td>
        </tr>
    </tbody>
</table>
<input type="button" class="ui button olive ip_button" value="{{ TEXT.SAVE }}" />
<input type="button" class="ui button ip_button" value="{{ TEXT.CANCEL }}" />
</form>
<div>
<p class="spacer1"></p>
{% endautoescape %}